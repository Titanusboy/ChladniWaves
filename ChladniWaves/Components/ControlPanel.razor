@inject SceneStateService State
@using System.Globalization

<div class="control-panel">
    <h3>Параметры волн</h3>

    <div class="slider-group">
        <div class="slider-label">
            <span>Длина волны</span>
            <span class="value">@State.Wavelength.ToString("F2", CultureInfo.InvariantCulture)</span>
        </div>
        <input type="range" min="3" max="20" step="0.01"
               value="@State.Wavelength.ToString(CultureInfo.InvariantCulture)"
               @oninput="e => SetFloat(e, v => State.Wavelength = v)" />
    </div>

    <div class="slider-group">
        <div class="slider-label">
            <span>Амплитуда</span>
            <span class="value">@State.Amplitude.ToString("F2", CultureInfo.InvariantCulture)</span>
        </div>
        <input type="range" min="0.1" max="3" step="0.01"
               value="@State.Amplitude.ToString(CultureInfo.InvariantCulture)"
               @oninput="e => SetFloat(e, v => State.Amplitude = v)" />
    </div>

    <div class="slider-group">
        <div class="slider-label">
            <span>Скорость</span>
            <span class="value">@State.Speed.ToString("F2", CultureInfo.InvariantCulture)</span>
        </div>
        <input type="range" min="0" max="10" step="0.01"
               value="@State.Speed.ToString(CultureInfo.InvariantCulture)"
               @oninput="e => SetFloat(e, v => State.Speed = v)" />
    </div>

    <div class="slider-group">
        <div class="slider-label">
            <span>Скорость времени</span>
            <span class="value">@State.TimeScale.ToString("F2", CultureInfo.InvariantCulture)</span>
        </div>
        <input type="range" min="0" max="3" step="0.01"
               value="@State.TimeScale.ToString(CultureInfo.InvariantCulture)"
               @oninput="e => SetFloat(e, v => State.TimeScale = v)" />
    </div>
</div>

@code {
    private void SetFloat(ChangeEventArgs e, Action<float> setter)
    {
        var s = e.Value?.ToString();
        if (string.IsNullOrEmpty(s)) return;

        if (float.TryParse(s, NumberStyles.Float, CultureInfo.InvariantCulture, out var v))
        {
            setter(v);
        }
    }
}