@inject SceneStateService State

<div class="camera-buttons">
    <button class="cam-btn" @onclick='() => State.SetCameraMode("orbit")'>Обзор</button>
    <button class="cam-btn" @onclick='() => State.SetCameraMode("top")'>Сверху</button>
    <button class="cam-btn" @onclick='() => State.SetCameraMode("cinematic")'>Кинематограф</button>
    <button class="cam-btn" @onclick="() => State.RequestScreenshot()">📷 Снимок</button>
</div>